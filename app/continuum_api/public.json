  {
    "method": "GET",
    "path": "/api/v1/tools/h3-face-refine/source",
    "summary": "Read authorized face-repair source facts",
    "description": "Inspect the exact current Gallery source through the existing bounded CPU decoder. Requires face-repair feature availability, project.generate, model visibility and H3 terms/legal access. Reads reauthorize after decoding; this does not load a model or activate face repair. Source length must be 124\u2013345 frames with frame_count % 17 == 5 and supported geometry.",
    "parameters": [
      {
        "name": "workspace",
        "in": "query",
        "required": true,
        "description": "Exact authorized project name.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^/\\\\\\x00-\\x1f]+$"
        }
      },
      {
        "name": "name",
        "in": "query",
        "required": true,
        "description": "Exact current Gallery output filename.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^/\\\\\\x00-\\x1f]+$"
        }
      },
      {
        "name": "revision",
        "in": "query",
        "required": true,
        "description": "Current Gallery listing revision; stale sources fail with 409.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^/\\\\\\x00-\\x1f]+$"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Authorized measured source facts",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "workspace": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                },
                "width": {
                  "type": "integer"
                },
                "height": {
                  "type": "integer"
                },
                "frame_count": {
                  "type": "integer"
                },
                "fps": {
                  "type": "string"
                },
                "audio_streams": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ordinal": {
                        "type": "integer"
                      },
                      "label": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "ordinal",
                      "label"
                    ]
                  }
                }
              },
              "required": [
                "workspace",
                "name",
                "revision",
                "width",
                "height",
                "frame_count",
                "fps",
                "audio_streams"
              ]
            }
          }
        }
      },
      "429": {
        "description": "Two CPU preview readers are busy. Wait using Retry-After; no model work was submitted."
      },
      "499": {
        "description": "The disconnected preview reader was cancelled and its CPU decoder drained."
      }
    },
    "x-maestro": {
      "feature": "editing.face_refine",
      "contract_status": "authored",
      "mcp": true,
      "boundary": "Feature availability, project.generate, current source revision, legal/terms and private-output authorization apply. No local path or authority inputs.",
      "idempotency": "Read-only; repeat with the same source revision. Stale sources require a fresh Gallery review.",
      "idempotent": true,
      "destructive": false,
      "open_world": false
    }
  },
