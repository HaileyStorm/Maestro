# Copy these values into Pinokio's Configure tab. Keep local secrets out of
# version control. Cloudflare app sharing is enabled by default; LAN binding
# remains disabled. Remote content stays behind per-project passwords and the
# backend denies machine-wide controls. An outer Pinokio passcode is optional.
PINOKIO_SCRIPT_AUTOLAUNCH=
PINOKIO_SCRIPT_REQUIRES=
PINOKIO_SHARE_CLOUDFLARE=true
PINOKIO_SHARE_PASSCODE=
# Optional stable Cloudflare Workers Free share. Proxy mode is the default;
# redirect remains the bounded rollback mode. Provision it with
# cloudflare/stable-share-worker/provision.mjs. Secrets must stay blank here
# and live only in the ignored ENVIRONMENT file.
PINOKIO_STABLE_SHARE_URL=
PINOKIO_STABLE_SHARE_UPDATE_SECRET=
PINOKIO_STABLE_SHARE_WORKER_NAME=maestro-stable-share
SHARE_MODE=proxy
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_WORKERS_FREE_CONFIRMED=
PINOKIO_SCRIPT_DEFAULT=true
GRADIO_TEMP_DIR=./cache/GRADIO_TEMP_DIR
HF_HOME=
TORCH_HOME=./cache/TORCH_HOME
# Optional owner-supplied, ignored JSON plan for future storage tiers. The
# inspector is read-only and does nothing when this is blank.
MAESTRO_STORAGE_TIER_PLAN_FILE=
PINOKIO_SHARE_LOCAL=false
PINOKIO_SHARE_LOCAL_PORT=

# Optional public Support links. Each option is disabled unless explicitly
# enabled; an enabled option also needs a valid URL before it is available.
# These are passive external links only: they do not enable payment ingestion,
# webhooks, hosted compute, account benefits, or credit enforcement.
MAESTRO_SUPPORT_BUY_ME_A_COFFEE_ENABLED=false
MAESTRO_SUPPORT_BUY_ME_A_COFFEE_URL=
MAESTRO_SUPPORT_PATREON_ENABLED=false
MAESTRO_SUPPORT_PATREON_URL=
MAESTRO_SUPPORT_DIRECT_COMPUTE_SPONSORSHIP_ENABLED=false
MAESTRO_SUPPORT_DIRECT_COMPUTE_SPONSORSHIP_URL=

# Optional host accounts are disabled by default. Creating the first owner is
# a temporary, direct-loopback-only operation: opt in to both flags, restart,
# create the owner in Maestro's local Account UI, then set bootstrap back to
# false and restart. Never put passwords, recovery codes, account-store data,
# or signing secrets in this file.
MAESTRO_ACCOUNTS_ENABLED=false
MAESTRO_ACCOUNT_BOOTSTRAP_ENABLED=false
# Enable only after owner bootstrap and active project migration. Signup remains
# limited to this launch's exact registered stable/Quick Cloudflare origins.
MAESTRO_PUBLIC_REGISTRATION_ENABLED=false

# Hosted credit enforcement is an optional operator policy and remains off for
# local installs. Enabling it is meaningful only with accounts, a hosted
# execution realm, and backend accounting readiness; these values are not
# credentials and must not contain secrets.
MAESTRO_HOSTED_CREDIT_ENFORCEMENT_ENABLED=false
MAESTRO_COMPUTE_EXECUTION_REALM=local
